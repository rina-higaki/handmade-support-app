<!-- app/views/items/new.html.erb -->
<h1>作品を登録</h1>

<div class="form-and-preview">

  <div class="form-card">
    <%= form_with model: @item, local: true, html: { multipart: true }, id: "item-form" do |f| %>

      <div class="form-group">
        <%= f.label :title, "タイトル" %>
        <%= f.text_field :title, class: "form-input", id: "item_title_input" %>
      </div>

      <div class="form-group">
        <%= f.label :description, "説明" %>
        <%= f.text_area :description, class: "form-input form-textarea", id: "item_description_input" %>
      </div>

      <div class="form-group">
        <%= f.label :price, "価格" %>
        <%= f.number_field :price, class: "form-input", id: "item_price_input" %>
      </div>

      <div class="form-group">
        <%= f.label :stock, "在庫数" %>
        <%= f.number_field :stock, class: "form-input", id: "item_stock_input" %>
      </div>

      <div class="form-group">
        <%= f.label :image, "メイン画像" %>
        <%= f.file_field :image, class: "form-input", id: "item_image_input" %>
      </div>

      <div class="actions">
        <%= f.submit "登録する", class: "button" %>
        <%= link_to '一覧に戻る', items_path, class: "link-back" %>
      </div>

    <% end %>
  </div>

  <!-- プレビュー用カード -->
  <div class="item-preview-card" id="item_preview">
    <img src="" class="card-image" id="preview_image" style="display:none;">
    <h2 id="preview_title">タイトル</h2>
    <p class="description" id="preview_description">説明文がここに表示されます</p>
    <div class="card-footer">
      <p class="price" id="preview_price">¥0</p>
      <p class="stock" id="preview_stock">在庫数：0</p>
    </div>
  </div>

</div>