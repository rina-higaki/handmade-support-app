<h1>作品を登録</h1>

<div class="form-card">
  <%= form_with model: @item, local: true do |form| %>

    <div class="form-group">
      <%= form.label :title, "作品名" %>
      <%= form.text_field :title, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :description, "説明" %>
      <%= form.text_area :description, class: "form-input form-textarea" %>
    </div>

    <div class="form-group">
      <%= form.label :price, "価格" %>
      <%= form.number_field :price, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :stock, "在庫数" %>
      <%= form.number_field :stock, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :image, "作品画像" %>
      <%= form.file_field :image %>
    </div>

    <div class="actions">
      <%= form.submit "登録する", class: "button" %>
      <%= link_to "一覧に戻る", items_path, class: "link-back" %>
    </div>

  <% end %>
</div>