<!-- app/views/items/show.html.erb -->

<div class="a">
  <%= link_to '作品一覧に戻る', items_path, class: "link-back" %>
</div>

<%# 作品タイトル %>
<h2 class="card-title"><%= @item.title %></h2>

<%# ボタン領域（未実装 → ダミー化） %>
<div class="detail-actions">
    <button type="button" class="button dummy">編集</button>
    <button type="button" class="button dummy">削除</button>
</div>

<%# 詳細カード領域 %>
<div class="detail-container">
  <div class="detail card">

    <%# メイン画像 %>
    <% if @item.image.attached? %>
      <%= image_tag @item.image, class: "card-image" %>
    <% end %>

    <%# タイトル %>
    <h2 class="card-title"><%= @item.title %></h2>

    <%# 説明文 %>
    <p class="card-description"><%= @item.description %></p>

    <%# 価格と在庫数 %>
    <div class="card-footer">
      <p class="price">¥<%= @item.price %></p>
      <p class="stock">在庫数：<%= @item.stock %></p>
    </div>
  </div>
</div>